    <detail>
        <band height="48">
            <textField><reportElement x="10" y="5" width="98" height="16" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{appointmentCode}]]></textFieldExpression></textField>
            <textField><reportElement x="10" y="23" width="98" height="16" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{scheduledAt}]]></textFieldExpression></textField>
            <textField><reportElement x="116" y="5" width="166" height="17" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{doctorName}]]></textFieldExpression></textField>
            <textField><reportElement x="116" y="24" width="166" height="16" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{specialty} + "  •  " + $F{duration}]]></textFieldExpression></textField>
            <textField pattern="R$ #,##0.00"><reportElement x="290" y="8" width="65" height="18" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{fee}]]></textFieldExpression></textField>
            <textField><reportElement x="360" y="6" width="88" height="16" forecolor="#176B70"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{paymentMethod}]]></textFieldExpression></textField>
