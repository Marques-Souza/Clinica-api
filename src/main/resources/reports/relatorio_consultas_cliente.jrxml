<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="relatorio_consultas_cliente" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">
    <parameter name="clientName" class="java.lang.String"/>
    <parameter name="clientCpf" class="java.lang.String"/>
    <parameter name="clientEmail" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="appointmentCount" class="java.lang.Integer"/>
    <parameter name="totalAmount" class="java.math.BigDecimal"/>
