            <staticText><reportElement x="324" y="18" width="100" height="16" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[TOTAL LISTADO]]></text></staticText>
            <textField pattern="R$ #,##0.00"><reportElement x="324" y="34" width="190" height="21" forecolor="#176B70"/><textElement><font fontName="SansSerif" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{totalAmount}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="63" width="535" height="12" forecolor="#617985"/><textElement><font fontName="SansSerif" size="7"/></textElement><text><![CDATA[Demonstrativo informativo. Este documento não substitui nota fiscal.]]></text></staticText>
