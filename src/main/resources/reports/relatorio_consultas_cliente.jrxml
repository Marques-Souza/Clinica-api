            <staticText><reportElement x="86" y="14" width="330" height="31" forecolor="#FFFFFF"/><textElement><font fontName="SansSerif" size="23" isBold="true"/></textElement><text><![CDATA[CLINICA]]></text></staticText>
            <staticText><reportElement x="88" y="48" width="350" height="17" forecolor="#BDE8E3"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[SAUDE  |  CUIDADO  |  BEM-ESTAR]]></text></staticText>
            <staticText><reportElement x="0" y="96" width="535" height="25" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="17" isBold="true"/></textElement><text><![CDATA[Demonstrativo de consultas]]></text></staticText>
            <staticText><reportElement x="0" y="121" width="535" height="17" forecolor="#617985"/><textElement><font fontName="SansSerif" size="9"/></textElement><text><![CDATA[Resumo dos atendimentos vinculados ao seu cadastro]]></text></staticText>
            <rectangle><reportElement mode="Opaque" x="0" y="145" width="535" height="1" forecolor="#D9E7E8" backcolor="#D9E7E8"/></rectangle>
            <staticText><reportElement x="0" y="153" width="63" height="14" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[CLIENTE]]></text></staticText>
            <textField><reportElement x="0" y="166" width="260" height="17" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{clientName}]]></textFieldExpression></textField>
            <staticText><reportElement x="275" y="153" width="50" height="14" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[CPF]]></text></staticText>
            <textField><reportElement x="275" y="166" width="120" height="17" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{clientCpf}]]></textFieldExpression></textField>
            <staticText><reportElement x="410" y="153" width="100" height="14" forecolor="#617985"/><textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement><text><![CDATA[EMITIDO EM]]></text></staticText>
            <textField><reportElement x="410" y="166" width="125" height="17" forecolor="#123B4A"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{generatedAt}]]></textFieldExpression></textField>
