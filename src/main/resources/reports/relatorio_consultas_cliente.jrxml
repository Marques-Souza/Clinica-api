    <field name="scheduledAt" class="java.lang.String"/>
    <field name="doctorName" class="java.lang.String"/>
    <field name="specialty" class="java.lang.String"/>
    <field name="duration" class="java.lang.String"/>
    <field name="fee" class="java.math.BigDecimal"/>
    <field name="paymentMethod" class="java.lang.String"/>
    <field name="paymentStatus" class="java.lang.String"/>
    <field name="appointmentStatus" class="java.lang.String"/>
    <title>
        <band height="186">
